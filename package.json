{
  "name": "@videodock/push-service",
  "version": "0.3.0",
  "description": "Framework-agnostic Firebase push service helpers for topic subscriptions and notifications.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf lib",
    "prepublishOnly": "pnpm build",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "firebase",
    "fcm",
    "push",
    "notifications"
  ],
  "license": "MIT",
  "peerDependencies": {
    "firebase-admin": ">=13 <15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "firebase-admin": ">=13 <15",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
